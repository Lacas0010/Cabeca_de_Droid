# Configurações opcionais do servidor Cabeça de Droid
# Renomeie este arquivo para ".env" na mesma pasta do executável ou em %APPDATA%\Cabeca_de_Droid\.env

# Endereço de bind do servidor (padrão: 127.0.0.1 para acesso apenas local; use 0.0.0.0 para liberar LAN)
HOST=127.0.0.1

# Porta padrão do servidor web local
PORT=8000

# Define como 1 para liberar acesso via rede local (LAN/Wi-Fi)
ALLOW_LAN=0
